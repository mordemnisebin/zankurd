# ZanKurd FTP deploy secrets — GERÇEK değerleri `.env.deploy` içine kopyala.
# `.env.deploy` git tarafından yok sayılır; bu örnek dosya güvenle commit edilir.
FTP_HOST="your-ftp-host"
FTP_USER="your-ftp-user"
FTP_PASS="your-ftp-password"

# İsteğe bağlı (varsayılanlar deploy_ftp.sh içinde):
# LOCAL_DIR="./build/web"
# REMOTE_DIR="public_html"

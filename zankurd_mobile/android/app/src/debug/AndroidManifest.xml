<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Yalnız hata ayıklama derlemesi: emülatör host'taki yerel Supabase'e
         `http://10.0.2.2:54321` ile ulaşır. Android 9'dan beri düz metin
         trafiği varsayılan olarak kapalıdır ve bu bayrak olmadan yerel arka
         uçla iki cihazlı oda denemesi hiç kurulamıyor. Yayın manifestine
         DOKUNULMAZ; üretim yalnız HTTPS konuşur. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>

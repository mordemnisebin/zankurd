<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Supabase/Firebase require network access; declared explicitly instead of
         relying on plugin manifest merging. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Telaffuz atölyesi: kayıt yalnız cihazda kalır (2026-10-26). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Reklam kimliği KALDIRILIR.
         ZanKurd reklam göstermiyor ve `terms.html` de "reklamsız" diyor.
         Buna rağmen firebase_analytics birleştirme sırasında AD_ID ve
         Privacy Sandbox ilişkilendirme izinlerini ikiliye sokuyordu
         (2026-08-01 denetimi, aapt2 badging ile doğrulandı). Sonuç:
         Play Data Safety'de "reklam kimliği toplanmıyor" beyanı ile
         ikilinin kendisi çelişiyordu — ve hedef kitle çocukları
         kapsıyorsa bu doğrudan bir Families politika ihlalidir.
         Beyanı gerçeğe uydurmak yerine gerçeği beyana uyduruyoruz:
         izinler kaldırılıyor. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>

    <application
        android:label="ZanKurd"
        android:name="${applicationName}"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">

        <!-- Local notifications receivers -->
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" android:exported="false" />
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.zankurd.app" android:host="login-callback"/>
            </intent-filter>
            <!-- Oda daveti App Links: https://www.zankurd.com/join/<KOD> ve
                 https://zankurd.com/join/<KOD>. `autoVerify="true"` Android'e
                 assetlinks.json'ı denetleyip doğrularsa bu bağlantıları
                 tarayıcıya değil doğrudan bu Activity'ye yönlendirmesini
                 söyler. Play App Signing parmak izi Play'e çıkınca
                 assetlinks.json'a EKLENMEDEN doğrulama üretim imzalı APK
                 için başarısız kalır (bkz. test belgesi). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="www.zankurd.com"
                    android:pathPrefix="/join/"/>
                <data
                    android:scheme="https"
                    android:host="zankurd.com"
                    android:pathPrefix="/join/"/>
            </intent-filter>
            <!-- Web'deki /join.html "Uygulamada aç" düğmesi intent:// ile bu
                 şemayı açar: App Links doğrulaması tutmasa (ör. eski kurulum)
                 bile bağlantı odaya gider. Yol https bağlantısıyla aynı, böylece
                 JoinDeepLink.parse ikisini tek kurala göre çözer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="com.zankurd.app"
                    android:host="zankurd.com"
                    android:pathPrefix="/join/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- Analytics VARSAYILAN OLARAK KAPALI.
             `AnalyticsConsentProvider` varsayılanı `false` ve
             `main.dart` özel olayları rıza kapısının arkasına alıyor —
             ama Firebase'in YEREL SDK'sı `Firebase.initializeApp()` ile
             birlikte kendiliğinden açılıyor ve first_open/session_start/
             app_open olaylarını rıza sorulmadan topluyordu
             (2026-08-01 denetimi, P2-008). Uygulamanın kendi opt-in
             duruşu ile ikilinin davranışı çelişiyordu.
             Toplama artık yalnız kullanıcı izin verdiğinde
             `setAnalyticsCollectionEnabled(true)` ile açılır. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- FCM varsayılanları (arka planda gelen push).
             Uygulama arka plandayken `notification` yüklü FCM iletisini
             Dart değil sistem çizer ve küçük simge/renk/kanalı BURADAN
             okur. Bu üçü olmadan (a) simge başlatıcı simgesine düşer ve
             bildirimde düz beyaz kare çıkar (`ic_stat_zankurd` saydam
             siluettir), (b) renk atanmaz, (c) kanal "Miscellaneous"
             yedeğine düşer ve kullanıcı ZanKurd bildirimlerini
             ayrı yönetemez. Sunucu (`send-push`) Android `channel_id`
             göndermiyor; kanal yalnız burada seçilir.
             Kanal kimliği `NotificationService.pushChannelId` ile aynı olmalı
             (uygulama açılışında oluşturulur). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_zankurd" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/zk_notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zankurd_friend_requests" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

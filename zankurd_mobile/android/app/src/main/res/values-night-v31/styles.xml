<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (gece): sistem açılış API'si. Bu dosya yokken sistem varsayılan
  tema zeminini ve başlatıcı simgesini daireye kırpıp gösteriyordu; test
  eden "açılış ekranı çok kaba" dedi. Zemin Flutter'ın ilk karesiyle aynı,
  simge güvenli bölgede, simge zemini = ekran zemini (daire görünmez).
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/zk_splash_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/zk_splash_bg_dark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/zk_splash_bg_dark</item>
    </style>
</resources>

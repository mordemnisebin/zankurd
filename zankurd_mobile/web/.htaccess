# Hostinger / Apache — Flutter web (SPA + Wasm MIME)
# Wasm deploy: .wasm ve .mjs mutlaka doğru Content-Type ister.
# text/plain → tarayıcı modülü reddeder, ekran boş kalır.

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://*.google-analytics.com https://*.revenuecat.com https://www.gstatic.com https://www.googletagmanager.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:"
</IfModule>

# --- MIME types (kritik) ---
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
  AddType application/javascript .js
  AddType application/json .json
  AddType font/ttf .ttf
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# Bazı paylaşımlı hostlarda AddType yetmez; dosya bazlı zorla:
<IfModule mod_headers.c>
  <FilesMatch "\.wasm$">
    Header set Content-Type "application/wasm"
  </FilesMatch>
  <FilesMatch "\.mjs$">
    Header set Content-Type "text/javascript"
  </FilesMatch>
</IfModule>

# --- SPA fallback (refresh / deep link) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Cache ---
<IfModule mod_headers.c>
  # Görsel ve fontlar bir hafta tutulabilir. Flutter kodu ve JSON içerik
  # dosyaları ise sabit ad taşıdığı için her yayında doğrulanır.
  <FilesMatch "\.(png|jpg|jpeg|webp|woff|woff2|ttf|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(js|mjs|wasm|css|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Flutter bu dosyaları içerik hash'i olmayan sabit adlarla üretir. Her
  # istekte yeniden doğrulanmazlarsa yeni yayın eski main.dart.js ile açılır.
  #
  # `no-store` DEĞİL, `no-cache`: ikisi birlikte yazıldığında `no-store`
  # kazanır ve tarayıcı dosyayı diske hiç koymaz — o zaman her açılışta,
  # her yenilemede, her derin bağlantıda 12,9 MB'lık main.dart.js sıfırdan
  # iner. `no-cache` ise "sakla ama kullanmadan önce doğrula" demektir:
  # bayat bundle riski aynı biçimde kapalı kalır, ama dosya değişmediğinde
  # sunucu 304 döner ve gövde hiç inmez (2026-07-31 denetimi).
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|main\.dart\.js|flutter_service_worker\.js|manifest\.json|version\.json|privacy\.html|terms\.html|delete-account\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Sıkıştırma ---
# main.dart.js sıkıştırılmadan ~12,9 MB; gzip ile dörtte birine iner.
# Hostinger bunu her zaman kendiliğinden açmıyor, bu yüzden açıkça isteniyor.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript \
    application/javascript application/json application/wasm image/svg+xml
</IfModule>

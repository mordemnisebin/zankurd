B.axy={everyday_1:0,everyday_2:1,everyday_3:2,grammar_1:3,grammar_2:4,culture_1:5,culture_2:6,food_1:7,food_2:8,animals_1:9,animals_2:10,geography_1:11,geography_2:12,emotions_1:13,emotions_2:14,time_1:15,time_2:16}
B.a_g=new A.cv("everyday_1_s1","everyday_1",1,"Di Kurmanc\xee de silav\xean bingeh\xeen:\n\n\u2022 Rojba\u015f: G\xfcnayd\u0131n / \u0130yi g\xfcnler\n\u2022 \xcavarba\u015f: \u0130yi ak\u015famlar\n\u2022 \u015eevba\u015f: \u0130yi geceler","K\xfcrt\xe7ede temel selamla\u015fma ifadeleri.",null,null)
B.a_G=new A.cv("everyday_1_s2","everyday_1",2,"Rew\u015f pirs\xeen:\n\n\u2022 \xc7on\xee? / Tu \xe7awa y\xee?: Nas\u0131ls\u0131n?\n\u2022 Ez ba\u015f im, spas dikim: \u0130yiyim, te\u015fekk\xfcr ederim.","Hal hat\u0131r sorma kal\u0131plar\u0131.",null,null)
B.a2H=s([B.a_g,B.a_G],t.R)
B.a_u=new A.cv("everyday_2_s1","everyday_2",1,"Nav pirs\xeen:\n\n\u2022 Nav\xea te \xe7i ye?: Ad\u0131n ne?\n\u2022 Nav\xea min Azad e: Benim ad\u0131m Azad.","\u0130sim sorma ve kendini tan\u0131tma.",null,null)
B.a_w=new A.cv("everyday_2_s2","everyday_2",2,"Welat / C\xee pirs\xeen:\n\n\u2022 Tu ji ku der\xea y\xee?: Nerelisin?\n\u2022 Ez ji Amed\xea me: Amedliyim.","Memleket sorma ve belirtme.",null,null)

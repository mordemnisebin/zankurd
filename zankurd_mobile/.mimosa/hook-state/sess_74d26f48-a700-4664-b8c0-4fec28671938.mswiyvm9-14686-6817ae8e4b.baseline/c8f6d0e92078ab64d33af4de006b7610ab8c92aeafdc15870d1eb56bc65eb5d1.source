B.alJ=new A.h(B.e,["Hesab nehat j\xeabirin. Ji kerema xwe d\xeesa bicerib\xeene.","Hesap silinemedi. L\xfctfen tekrar dene."],t.w)
B.agF=new A.h(B.e,["Hesab hate j\xeabirin, l\xea daney\xean li ser v\xea am\xfbr\xea bi tevah\xee nehatin paqij kirin. Sepan\xea ji n\xfb ve bide destp\xeakirin; eger hi\u015fyar\xee bidome, sepan\xea ji n\xfb ve saz bike.","Hesap silindi ancak bu cihazdaki yerel veriler tamamen temizlenemedi. Uygulamay\u0131 yeniden ba\u015flat; uyar\u0131 s\xfcrerse uygulamay\u0131 yeniden y\xfckle."],t.w)
B.agA=new A.h(B.e,["Dest\xfbra agahdariy\xea nehat day\xeen; ji m\xeeheng\xean s\xeestem\xea veke.","Bildirim izni verilmedi; sistem ayarlar\u0131ndan a\xe7."],t.w)
B.amB=new A.h(B.e,["Pergal dest\xfbra agahdariyan nade ZanKurd. Ji kerema xwe ji m\xeeheng\xean s\xeestema am\xfbr\xea ve agahdariy\xean ZanKurd veke.","Sistem, ZanKurd i\xe7in bildirimlere izin vermiyor. L\xfctfen cihaz\u0131n\u0131n sistem ayarlar\u0131ndan ZanKurd bildirimlerini a\xe7."],t.w)
B.aj3=new A.h(B.e,["\u2022 P\xea\u015fbirka Bilez: tavil\xea 10 pirsan bibersiv\xeene.\n\u2022 \xc7alakiya Roj\xea: her roj 10 pirsan bibersiv\xeene \xfb p\xea\u015fketina xwe bib\xeene.\n\u2022 Odeyek Ava Bike: kod\xea bide heval\xean xwe \xfb bi hev re bil\xeezin.\n\u2022 Kategor\xee \xfb Ast: ji 9 kategoriyan \xfb 5 astan hilbij\xeare.\n\u2022 Joker 50/50: du bersiv\xean \u015fa\u015f radike.\n\u2022 Bersiv\xean rast p\xfban \xfb z\xear didin; r\xeaza rast p\xfban\xean z\xeade dide.","\u2022 H\u0131zl\u0131 d\xfcello: hemen 10 soru cevapla.\n\u2022 G\xfcn\xfcn Etkinli\u011fi: her g\xfcn 10 soruyu cevapla ve ilerlemeni g\xf6r.\n\u2022 Oda Kur: kodu arkada\u015flar\u0131na ver, birlikte yar\u0131\u015f\u0131n.\n\u2022 Kategori ve Seviye: 9 kategori, 5 seviye aras\u0131ndan se\xe7.\n\u2022 50/50 jokeri iki yanl\u0131\u015f cevab\u0131 eler.\n\u2022 Do\u011fru cevap puan ve coin kazand\u0131r\u0131r; seri bonusu art\u0131r\u0131r."],t.w)
B.alI=new A.h(B.e,["ZanKurd ev daney\xean serh\xeal tomar dike: nav\xea l\xeestikvan, navn\xee\u015fana e-namey\xea (heke tomar bib\xee), p\xfban, stat\xeest\xeek \xfb daney\xean l\xeestik \xfb hevberkirin\xea, hejmara z\xearan, pirs\xean tomarkir\xee, peyam\xean odey\xea \xfb p\xea\u015fniyar\xean pirsan. XP, zinc\xeer, \u015fa\u015f\xee \xfb p\xea\u015fketina h\xeenb\xfbn\xea li ser v\xea am\xfbr\xea t\xean parastin; dema tu derkev\xee ew ji am\xfbr\xea t\xean paqij kirin. Di xetayan de tomar\xean tekn\xeek\xee y\xean anon\xeem t\xean berhevkirin. Anal\xeeza bikaran\xeen\xea ten\xea heke tu w\xea ji M\xeeheng > Nepen\xee \xfb Daney\xean ve vek\xee t\xea \xe7alak kirin.\n\nDaney\xean te nay\xean firotin \xfb ji bo reklam\xea bi kes\xean s\xeayem\xeen re nay\xean parvekirin. Nav\xea te di tabloya p\xea\u015fengan, l\xeager\xeena hevalan, daxwaz\xean hevaltiy\xea \xfb odey\xean serh\xeal de xuya dibe.\n\nJi bo j\xeabirina hesab\xea \xfb hem\xfb daney\xean serh\xeal: M\xeeheng > Hesab > Hesab\xea Min J\xea Bibe.","ZanKurd \u015fu \xe7evrimi\xe7i verileri saklar: oyuncu ad\u0131, e-posta adresi (kay\u0131t olursan), oyun ve e\u015fle\u015ftirme puanlar\u0131, istatistikleri ve verileri, coin bakiyesi, kaydedilen sorular, oda mesajlar\u0131 ve soru \xf6nerileri. XP, seri, yanl\u0131\u015flar ve \xf6\u011frenme ilerlemesi yaln\u0131z bu cihazda tutulur; \xe7\u0131k\u0131\u015f yapt\u0131\u011f\u0131nda cihazdan temizlenir. Hatalarda anonim teknik \xe7\xf6kme kay\u0131tlar\u0131 toplan\u0131r. Kullan\u0131m analizi yaln\u0131z Ayarlar > Gizlilik ve Veri se\xe7ene\u011fini a\xe7arsan etkinle\u015fir.\n\nVerilerin sat\u0131lmaz ve \xfc\xe7\xfcnc\xfc taraflarla pazarlama ama\xe7l\u0131 payla\u015f\u0131lmaz. Ad\u0131n liderlik tablosunda, arkada\u015f aramas\u0131 ve isteklerinde, ayr\u0131ca \xe7evrimi\xe7i odalarda g\xf6r\xfcn\xfcr.\n\nHesab\u0131n\u0131 ve t\xfcm \xe7evrimi\xe7i verilerini kal\u0131c\u0131 olarak silmek i\xe7in: Ayarlar > Hesap > Hesab\u0131m\u0131 Sil."],t.w)
B.aqM=new A.h(B.e,["Sepana p\xea\u015fbirk\xea ya Kurmanc\xee \u2014 ziman, \xe7and, d\xeerok, edebiyat, erdn\xeegar\xee \xfb muz\xeeka Kurd\xee h\xeen bibe \xfb p\xea\u015fbirk\xea bike.","Kurmanc\xee bilgi yar\u0131\u015fmas\u0131 uygulamas\u0131 \u2014 K\xfcrt dili, k\xfclt\xfcr\xfc, tarihi, edebiyat\u0131, co\u011frafyas\u0131 ve m\xfczi\u011fini \xf6\u011fren, yar\u0131\u015f."],t.w)
B.apg=new A.h(B.e,["Deng\xea kurd\xee li v\xea am\xfbr\xea s\xeenordar e; dibe ku dengek\xee din were bikaran\xeen.","Bu cihazda K\xfcrt\xe7e ses s\u0131n\u0131rl\u0131 olabilir; yedek bir ses kullan\u0131labilir."],t.w)
B.aoM=new A.h(B.e,["R\xeaber","Rehber"],t.w)
B.anj=new A.h(B.e,["Ji n\xfb ve","Yeniden ba\u015flat"],t.w)
B.alh=new A.h(B.e,["D\xeesa bil\xeeze","Tekrar oyna"],t.w)
B.ajT=new A.h(B.e,["Koleksiyona Rozetan","Rozet Koleksiyonu"],t.w)
B.agk=new A.h(B.e,["Hem\xfb","T\xfcm\xfc"],t.w)
B.ajn=new A.h(B.e,["Moda Ne li Serh\xeal","\xc7evrimd\u0131\u015f\u0131 Mod"],t.w)
B.aeU=new A.h(B.e,["Gir\xeadana \xeenternet\xea tune. Pirs wek\xee ne li serh\xeal t\xean barkirin.","\u0130nternet ba\u011flant\u0131s\u0131 yok. Sorular \xe7evrimd\u0131\u015f\u0131 y\xfckleniyor."],t.w)
B.agq=new A.h(B.e,["Gir\xeadana \xeenternet\xea tuneye \u2014 T\xea kontrolkirin\u2026","\u0130nternet ba\u011flant\u0131s\u0131 yok \u2014 Kontrol ediliyor\u2026"],t.w)
B.aga=new A.h(B.e,["Polit\xeekaya nepen\xeetiy\xea","Gizlilik Politikas\u0131"],t.w)
B.aet=new A.h(B.e,["Merc\xean bikaran\xeen\xea","Kullan\u0131m Ko\u015fullar\u0131"],t.w)
B.afe=new A.h(B.e,["H\xeen peyam tune. Yekem biniv\xeese!","Hen\xfcz mesaj yok. \u0130lk sen yaz!"],t.w)
B.akd=new A.h(B.e,["Peyamek biniv\xeese\u2026","Bir mesaj yaz\u2026"],t.w)
B.alc=new A.h(B.e,["H\xeaz \xfb Cih\xean P\xea\u015fketin\xea","G\xfc\xe7l\xfc ve Geli\u015ftirilecek Alanlar"],t.w)
B.amU=new A.h(B.e,["Xurt","G\xfc\xe7l\xfc"],t.w)
B.afl=new A.h(B.e,["Cih\xean p\xea\u015fketin\xea","Geli\u015ftirilecek"],t.w)
B.ahc=new A.h(B.e,["Ji bo anal\xeez\xea h\xea hindik dane heye. Pi\xe7ek\xee b\xeatir bil\xeeze!","Analiz i\xe7in hen\xfcz az veri var. Biraz daha oyna!"],t.w)
B.alk=new A.h(B.e,["Ji xwe bawer be","Formunu koru"],t.w)
B.alp=new A.h(B.e,["Dubarekirin amade","Tekrar haz\u0131r"],t.w)
B.afF=new A.h(B.e,["Pi\xe7ek prat\xeek ba\u015f e","Biraz pratik iyi gelir"],t.w)
B.aeO=new A.h(B.e,["Dubarekirin\xean \xcero","Bug\xfcnk\xfc Tekrarlar"],t.w)
B.ano=new A.h(B.e,["{count} pirs ji bo dubarekirin\xea amade ne","{count} soru tekrara haz\u0131r"],t.w)
B.apd=new A.h(B.e,["B\xeeran\xeena xwe xurt bike","Haf\u0131zan\u0131 peki\u015ftir"],t.w)
B.ajZ=new A.h(B.e,["Dubarekirin temam","Tekrarlar tamam"],t.w)
B.agc=new A.h(B.e,["\xcero pirs\xean te y\xean dubarekirin\xea tune","Bug\xfcn tekrar edilecek soru yok"],t.w)
B.ae5=new A.h(B.e,["Ma\xe7a {one} \xfb {two}","{one} ve {two} ma\xe7\u0131"],t.w)
B.ajt=new A.h(B.e,["BI DAW\xce B\xdb","B\u0130TT\u0130"],t.w)
B.akh=new A.h(B.e,["\xc7avkaniy\xean w\xeaneyan","G\xf6rsel kaynaklar\u0131"],t.w)
B.ahq=new A.h(B.e,["W\xeaney\xean pirsan ji Wikimedia Commons in \xfb bi l\xeesans\xean mal\xea gi\u015ft\xee, CC0 an CC BY t\xean bikaran\xeen. CC BY nav\xea w\xeanegir dixwaze; ev r\xfbpel ew erka yasay\xee p\xeak t\xeene.","Soru foto\u011fraflar\u0131 Wikimedia Commons'tan al\u0131nm\u0131\u015ft\u0131r ve kamu mal\u0131, CC0 ya da CC BY lisanslar\u0131yla kullan\u0131lmaktad\u0131r. CC BY foto\u011fraf\xe7\u0131n\u0131n ad\u0131n\u0131 anmay\u0131 \u015fart ko\u015far; bu sayfa o yasal y\xfck\xfcml\xfcl\xfc\u011f\xfc kar\u015f\u0131lar."],t.w)
B.apR=new A.h(B.e,["R\xfbpela \xe7avkaniy\xea","Kaynak sayfas\u0131"],t.w)
B.agZ=new A.h(B.e,["\u015e\xeerovey\xean tur\xea","Turun a\xe7\u0131klamalar\u0131"],t.w)
B.amN=new A.h(B.e,["Hem\xfb \u015f\xeerove li vir bi hev re ne \u2014 di dema tur\xea de ten\xea bersiva rast xuya dibe.","T\xfcm a\xe7\u0131klamalar burada bir arada \u2014 tur s\u0131ras\u0131nda yaln\u0131z do\u011fru cevap g\xf6r\xfcn\xfcr."],t.w)
B.adG=new A.h(B.e,["Bersiva rast","Do\u011fru cevap"],t.w)
B.aeB=new A.h(B.e,["Moda Zarokan","\xc7ocuk Modu"],t.w)
B.ajh=new A.h(B.e,["L\xeager\xeena hevalan \xfb parvekirina derve digire","Arkada\u015f aramay\u0131 ve d\u0131\u015fa payla\u015f\u0131m\u0131 kapat\u0131r"],t.w)
B.apc=new A.h(B.e,["Moda zarokan were vekirin?","\xc7ocuk modu a\xe7\u0131ls\u0131n m\u0131?"],t.w)
B.aig=new A.h(B.e,["Vekirin l\xeager\xeena heval \xfb parvekirina encaman a derve digire. Ev m\xeehengek am\xfbr\xea ye; li aliy\xea p\xea\u015fk\xea\u015fker\xea parastinek din tune.","A\xe7mak arkada\u015f aramay\u0131 ve sonu\xe7lar\u0131 d\u0131\u015fa payla\u015fmay\u0131 kapat\u0131r. Bu yaln\u0131z cihaz ayar\u0131d\u0131r; sunucu taraf\u0131nda ek bir koruma yoktur."],t.w)
B.afy=new A.h(B.e,["Moda zarokan vekir\xee ye \u2014 l\xeager\xeena hevalan girt\xee ye.","\xc7ocuk modu a\xe7\u0131k \u2014 arkada\u015f arama kapal\u0131."],t.w)

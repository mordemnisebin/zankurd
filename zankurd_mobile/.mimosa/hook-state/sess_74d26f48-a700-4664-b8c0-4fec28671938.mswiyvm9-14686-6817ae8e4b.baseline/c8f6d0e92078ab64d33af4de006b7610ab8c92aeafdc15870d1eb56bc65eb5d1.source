B.a3S=new A.cO("everyday_2_s1","everyday_2",1,"Nav pirs\xeen:\n\n\u2022 Nav\xea te \xe7i ye?: Ad\u0131n ne?\n\u2022 Nav\xea min Azad e: Benim ad\u0131m Azad.","\u0130sim sorma ve kendini tan\u0131tma.",null,null)
B.a3U=new A.cO("everyday_2_s2","everyday_2",2,"Welat / C\xee pirs\xeen:\n\n\u2022 Tu ji ku der\xea y\xee?: Nerelisin?\n\u2022 Ez ji Amed\xea me: Amedliyim.","Memleket sorma ve belirtme.",null,null)

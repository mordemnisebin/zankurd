B.awO=new A.bx("curated_movement_0011","Paradigma",'K\xeejan hevok li ser "demokrat\xeek konfederal\xeezm" bi awayek\xee her\xee rast t\xeagihi\u015ftin\xea dide?',B.a9I,u.b3,B.ae,null,B.aH,"Di niv\xeesar\xean tevger\xea de ev t\xeageh bi mecl\xees, kom\xeen, hevkar\xee \xfb biryargirtina ji j\xear ve t\xea \u015firovekirin.","Ev t\xeageh bi mecl\xees, kom\xeen, hevkar\xee \xfb biryargirtina ji j\xear ve t\xea \u015firovekirin.","Bu kavram meclis, kom\xfcn, dayan\u0131\u015fma ve a\u015fa\u011f\u0131dan karar almayla a\xe7\u0131klan\u0131r.",'"Demokratik konfederalizm" i\xe7in hangi c\xfcmle en do\u011fru anlay\u0131\u015f\u0131 verir?',B.a86,u.aR,null,null,null,B.aP,null,null,null,4,B.iQ)

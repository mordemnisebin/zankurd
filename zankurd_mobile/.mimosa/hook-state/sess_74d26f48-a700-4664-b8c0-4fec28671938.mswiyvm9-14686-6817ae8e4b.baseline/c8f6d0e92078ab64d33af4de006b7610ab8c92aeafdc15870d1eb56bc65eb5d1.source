B.aq4=new A.h(B.e,["Nav nehat tomar kirin. D\xeesa bicerib\xeene, an bi \xabPa\u015f\xea bike\xbb derbas bibe \xfb pa\u015f\xea ji prof\xeel\xea biniv\xeese.","Ad kaydedilemedi. Tekrar dene ya da \xab\u015eimdilik ge\xe7\xbb ile devam et, ad\u0131 sonra profilden yazars\u0131n."],t.w)

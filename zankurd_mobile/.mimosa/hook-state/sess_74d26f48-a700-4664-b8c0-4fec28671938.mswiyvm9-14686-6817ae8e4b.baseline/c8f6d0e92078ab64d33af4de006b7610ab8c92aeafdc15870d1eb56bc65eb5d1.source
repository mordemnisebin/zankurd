B.awl=new A.bx("curated_movement_0002","Siyaset",'Peyva Kurmanc\xee "azad\xee" bi Tirk\xee \xe7i t\xea gotin?',B.AF,"\xf6zg\xfcrl\xfck",B.ae,null,B.aH,'"Azad\xee" wateya azadiy\xea dide; peyv di slogan \xfb got\xfbb\xeaja mafan de j\xee gelek t\xea bikaran\xeen.','"Azad\xee" wateya azadiy\xea dide; peyv di slogan \xfb got\xfbb\xeaja mafan de gelek t\xea bikaran\xeen.','"Azad\xee" \xf6zg\xfcrl\xfck demektir; s\xf6zc\xfck sloganlarda ve hak tart\u0131\u015fmalar\u0131nda s\u0131k\xe7a kullan\u0131l\u0131r.','Kurmanc\xee "azad\xee" s\xf6zc\xfc\u011f\xfc T\xfcrk\xe7ede ne denir?',B.AF,"\xf6zg\xfcrl\xfck",null,null,null,B.aP,null,null,null,1,B.kD)

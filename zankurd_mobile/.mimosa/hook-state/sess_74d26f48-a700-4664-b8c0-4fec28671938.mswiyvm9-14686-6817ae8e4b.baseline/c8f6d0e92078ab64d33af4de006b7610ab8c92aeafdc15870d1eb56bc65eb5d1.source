B.awC=new A.bx("curated_movement_0015","Paradigma",'Rast e yan \u015fa\u015f e? "Xwe-r\xeaxistin ten\xea ji bo kes\xean ku li bajar\xean mezin dij\xeen e."',B.Ac,"\u015ea\u015f e",B.ae,null,B.aH,"Xwe-r\xeaxistin t\xeagehek e ku dikare di cih\xean cuda de, di nav kom \xfb civakan de, bi away\xean cuda were bikaran\xeen.","Xwe-r\xeaxistin di cih\xean cuda de, di nav kom \xfb civakan de bi away\xean cuda t\xea bikaran\xeen.","\xd6z \xf6rg\xfctlenme; farkl\u0131 yerlerde, farkl\u0131 grup ve toplumlarda farkl\u0131 bi\xe7imlerde uygulan\u0131r.",'Do\u011fru mu yanl\u0131\u015f m\u0131? "\xd6z \xf6rg\xfctlenme yaln\u0131zca b\xfcy\xfck \u015fehirlerde ya\u015fayanlar i\xe7indir."',B.AI,"Yanl\u0131\u015f",null,null,null,B.nk,null,null,null,2,B.iR)

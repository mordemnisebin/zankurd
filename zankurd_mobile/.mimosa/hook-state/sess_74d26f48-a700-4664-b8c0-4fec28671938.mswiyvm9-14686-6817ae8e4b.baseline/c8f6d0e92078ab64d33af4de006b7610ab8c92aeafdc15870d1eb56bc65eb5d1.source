B.awA=new A.bx("curated_movement_0008","\xc7and","Di w\xeaney\xea de agir\xea Newroz\xea t\xea d\xeetin. Di \xe7and \xfb hafizaya civak\xee de agir bi k\xeejan t\xeageh\xea re z\xeadetir t\xea gir\xeadan?",B.a5B,"H\xeav\xee \xfb vej\xeen",B.ae,null,B.aH,"Agir\xea Newroz\xea di gelek vegotin\xean Kurdan de bi ronah\xee, h\xeav\xee \xfb vej\xeena n\xfb re t\xea gir\xeadan.","Agir\xea Newroz\xea di gelek vegotin\xean kurdan de bi ronah\xee, h\xeav\xee \xfb vej\xeena n\xfb re t\xea gir\xeadan.","Newroz ate\u015fi bir\xe7ok K\xfcrt anlat\u0131s\u0131nda \u0131\u015f\u0131kla, umutla ve yeniden do\u011fu\u015fla ili\u015fkilendirilir.","G\xf6rselde Newroz ate\u015fi g\xf6r\xfcn\xfcyor. K\xfclt\xfcrde ve toplumsal bellekte ate\u015f hangi kavramla daha \xe7ok ili\u015fkilendirilir?",B.a5A,"Umut ve yeniden do\u011fu\u015f",null,null,null,B.nl,"asset://assets/question_images/newroz.webp",null,null,2,B.hl)

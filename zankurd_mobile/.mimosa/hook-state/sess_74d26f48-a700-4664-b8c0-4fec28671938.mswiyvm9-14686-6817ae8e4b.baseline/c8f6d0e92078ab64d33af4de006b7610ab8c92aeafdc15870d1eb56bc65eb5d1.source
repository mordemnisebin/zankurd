B.awG=new A.bx("curated_movement_0006","Paradigma",'Di v\xea hevok\xea de peyva "berxwedan" \xe7i dide zan\xeen? "Berxwedana wan dom kir."',B.a7J,"Ragirtina li hember zordariy\xea",B.ae,null,B.aH,u.F,u.F,'"Berxwedan" bu c\xfcmlede direnmek ve bask\u0131 kar\u015f\u0131s\u0131nda ayakta kalmak anlam\u0131ndad\u0131r.','\u015eu c\xfcmlede "berxwedan" ne anlat\u0131r? "Berxwedana wan dom kir."',B.ab8,"Bask\u0131ya kar\u015f\u0131 direnmek",null,null,null,B.aP,null,null,null,2,B.hl)

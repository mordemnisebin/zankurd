B.awq=new A.bx("curated_movement_0003","Paradigma",'Di got\xfbb\xeaja jinan de "jineoloj\xee" bi k\xeejan ravekirin\xea re z\xeadetir t\xea gir\xeadan?',B.a8K,u.aQ,B.ae,null,B.aH,"Jineoloj\xee di edebiyata tevger\xea de wek n\xeaz\xeekatiyek ji bo xwendina jiyana jinan, civak\xea \xfb t\xeakiliy\xean h\xeaz\xea t\xea p\xeanasekirin.","Jineoloj\xee wek n\xeaz\xeekatiyek ji bo xwendina jiyana jinan, civak\xea \xfb t\xeakiliy\xean h\xeaz\xea t\xea p\xeanasekirin.","Jineoloj\xee; kad\u0131nlar\u0131n ya\u015fam\u0131n\u0131, toplumu ve g\xfc\xe7 ili\u015fkilerini okumak i\xe7in bir yakla\u015f\u0131m olarak tan\u0131mlan\u0131r.",'Kad\u0131n tart\u0131\u015fmas\u0131nda "jineoloj\xee" hangi tan\u0131mla daha \xe7ok ili\u015fkilendirilir?',B.a5z,u.ac,null,null,null,B.aP,null,null,null,3,B.kD)

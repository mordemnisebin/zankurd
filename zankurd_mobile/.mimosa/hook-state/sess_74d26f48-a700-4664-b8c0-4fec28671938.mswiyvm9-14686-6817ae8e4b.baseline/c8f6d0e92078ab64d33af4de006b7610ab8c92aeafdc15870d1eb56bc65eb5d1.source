B.a3H=new A.cO("everyday_1_s2","everyday_1",2,"Rew\u015f pirs\xeen:\n\n\u2022 Tu \xe7awa y\xee?: Nas\u0131ls\u0131n?\n\u2022 Ez ba\u015f im, spas dikim: \u0130yiyim, te\u015fekk\xfcr ederim.","Hal hat\u0131r sorma kal\u0131plar\u0131.",null,null)

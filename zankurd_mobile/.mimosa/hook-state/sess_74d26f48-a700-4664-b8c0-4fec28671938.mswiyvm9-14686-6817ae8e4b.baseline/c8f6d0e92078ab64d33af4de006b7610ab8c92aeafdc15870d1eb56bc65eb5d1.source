B.awL=new A.bx("curated_movement_0009","\xc7and",'"Newroz" ji aliy\xea wateya peyv\xea ve bi k\xeejan ravekirin\xea re n\xeaz\xeek e?',B.aaw,"Roja n\xfb",B.ae,null,B.aH,'Newroz bi t\xeageha "roja n\xfb" re t\xea \u015firovekirin \xfb wek destp\xeaka demsala bihar\xea t\xea p\xeeroz kirin.','Newroz bi t\xeageha "roja n\xfb" re t\xea \u015firovekirin \xfb wek destp\xeaka demsala bihar\xea t\xea p\xeerozkirin.','Newroz "yeni g\xfcn" kavram\u0131yla a\xe7\u0131klan\u0131r ve bahar\u0131n ba\u015flang\u0131c\u0131 olarak kutlan\u0131r.','"Newroz" s\xf6zc\xfck anlam\u0131 bak\u0131m\u0131ndan hangi kar\u015f\u0131l\u0131\u011fa yak\u0131nd\u0131r?',B.a9_,"Yeni g\xfcn",null,null,null,B.aP,null,null,null,2,B.iQ)

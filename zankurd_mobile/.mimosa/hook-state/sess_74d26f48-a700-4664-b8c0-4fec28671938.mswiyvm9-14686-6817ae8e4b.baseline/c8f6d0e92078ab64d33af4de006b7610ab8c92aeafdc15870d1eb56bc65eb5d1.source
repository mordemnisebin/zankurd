B.awF=new A.bx("curated_movement_0005","Paradigma",'K\xeejan ravekirin ji bo "xwe-r\xeaxistin" rast e?',B.a82,u.aO,B.ae,null,B.aH,'"Xwe-r\xeaxistin" t\xea wateya ku kes \xfb kom bi hevkar\xee kar \xfb biryar\xean xwe r\xeaxistin dikin.','"Xwe-r\xeaxistin" t\xea wateya ku kes \xfb kom bi hevkar\xee kar \xfb biryar\xean xwe bi xwe r\xeaxistin dikin.','"Xwe-r\xeaxistin", ki\u015fi ve gruplar\u0131n i\u015flerini ve kararlar\u0131n\u0131 dayan\u0131\u015fmayla kendilerinin \xf6rg\xfctlemesidir.','"\xd6z \xf6rg\xfctlenme" i\xe7in hangi tan\u0131m do\u011frudur?',B.a6q,"Hak ve g\xf6revleri dayan\u0131\u015fmayla \xf6rg\xfctlemek",null,null,null,B.aP,null,null,null,2,B.hl)

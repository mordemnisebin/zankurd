B.awV=new A.bx("curated_movement_0001","Siyaset",'Di gotina "Jin, Jiyan, Azad\xee" de "jiyan" bi Tirk\xee \xe7i ye?',B.A0,"ya\u015fam",B.ae,null,B.aH,u.p,u.p,'"Jiyan" T\xfcrk\xe7ede "ya\u015fam" demektir. Bu s\xf6zde \xfc\xe7 kavram \u2014 kad\u0131n, ya\u015fam ve \xf6zg\xfcrl\xfck \u2014 birbirine ba\u011flan\u0131r.','"Jin, Jiyan, Azad\xee" s\xf6z\xfcndeki "jiyan" T\xfcrk\xe7ede ne demektir?',B.A0,"ya\u015fam",null,null,null,B.aP,null,null,null,1,B.kD)

B.axC={offline_0376:0,offline_0381:1,offline_0386:2,offline_2081:3,offline_2082:4,offline_2083:5,offline_2086:6,offline_2087:7,offline_2141:8,offline_2142:9,offline_2143:10,offline_2145:11,offline_2146:12,offline_2148:13,offline_2149:14,offline_2150:15,offline_2084:16,offline_2085:17,offline_2088:18,offline_2089:19,offline_2090:20,offline_2091:21,offline_2092:22,offline_2093:23,offline_2094:24,offline_2095:25,offline_2096:26,offline_2097:27,offline_2098:28,offline_2099:29,offline_2100:30,offline_2101:31,offline_2102:32,offline_2103:33,offline_2104:34,offline_2105:35,offline_2106:36,offline_2107:37,offline_2108:38,offline_2109:39,offline_2110:40,offline_0649:41,offline_0654:42,offline_0660:43,offline_0669:44,offline_0672:45,offline_2111:46,offline_2112:47,offline_2113:48,offline_2114:49,offline_2115:50,offline_2116:51,offline_2117:52,offline_2118:53,offline_2119:54,offline_2120:55,offline_2121:56,offline_2122:57,offline_2123:58,offline_2124:59,offline_2125:60,offline_2126:61,offline_2127:62,offline_2128:63,offline_2129:64,offline_0881:65,offline_0885:66,offline_0889:67,offline_0892:68,offline_2290:69,offline_2291:70,offline_2292:71,offline_2298:72,offline_2326:73,offline_2327:74,offline_2282:75,offline_2334:76,offline_2335:77,offline_0005:78,offline_0010:79,offline_0015:80,offline_0016:81,offline_0020:82,offline_0025:83,offline_0030:84,offline_0035:85,offline_0040:86,offline_0045:87,offline_0050:88,offline_0055:89,offline_0060:90,offline_0062:91,offline_0065:92,offline_0067:93,offline_0070:94,offline_0075:95,offline_7058:96,offline_7135:97,offline_7227:98,offline_7242:99,offline_8149:100,offline_8155:101,offline_9405:102,offline_6053:103}
B.Va=new A.aX("Newroz cejna hatina bihar\xea ye ku di 21\xea Adar\xea de t\xea p\xeerozkirin \xfb n\xfbb\xfbna xwezay\xea tems\xeel dike. Di \xe7anda kurd\xee de bi efsaneya Dehak \xfb Kaway\xea Hesinkar re t\xea gir\xeadan \xfb b\xfbye sembola azad\xee \xfb berxwedan\xea.","Newroz, 21 Mart'ta kutlanan ve bahar\u0131n geli\u015fini, do\u011fan\u0131n yeniden canlanmas\u0131n\u0131 simgeleyen bir bayramd\u0131r. K\xfcrt k\xfclt\xfcr\xfcnde Dehak ile Demirci Kawa efsanesine ba\u011flanarak \xf6zg\xfcrl\xfck ve direni\u015fin sembol\xfc olmu\u015ftur.")
B.V2=new A.aX("Govend d\xeelana bi dest\xea hev girt\xee ye ku bi kom\xee t\xea gotin. Di dawet \xfb \u015fahiyan de yek\xeet\xee \xfb hevgirtina civak\xea n\xee\u015fan dide.","Govend, el ele tutu\u015farak oynanan toplu bir halk oyunudur (halay). D\xfc\u011f\xfcn ve kutlamalarda toplulu\u011fun birlik ve dayan\u0131\u015fmas\u0131n\u0131 ifade eder.")
B.UR=new A.aX('Dengb\xeaj hunermend\xea \xe7anda devk\xee ya kurd\xee ye ku bi awaz \xe7\xeerokan vedib\xeaje. B\xfbyer\xean d\xeerok\xee, ev\xeen \xfb \xea\u015fan bi "kilam"an ji nif\u015fek\xea re dav\xeaje nif\u015f\xea din.','Dengb\xeaj, K\xfcrt s\xf6zl\xfc k\xfclt\xfcr\xfcnde ezgiyle hik\xe2ye anlatan halk sanat\xe7\u0131s\u0131d\u0131r. Tarih\xee olaylar\u0131, a\u015fklar\u0131 ve ac\u0131lar\u0131 "kilam" denen uzun ezgilerle ku\u015faktan ku\u015fa\u011fa aktar\u0131r.')
B.Vk=new A.aX("Navenda M\xeergeha Botan\xea bajar\xea Ciz\xeer\xea b\xfb. Di sedsala 19an de di bin serokatiya M\xeer Bedirxan de b\xfbye m\xeergeheke kurd\xee ya bih\xeaz \xfb n\xeev-xweser.","Botan M\xeerli\u011fi'nin merkezi Cizre (Ciz\xeer) \u015fehriydi. 19. y\xfczy\u0131lda M\xeer Bedirxan \xf6nderli\u011finde g\xfc\xe7l\xfc ve yar\u0131-\xf6zerk bir K\xfcrt beyli\u011fi olmu\u015ftur.")
B.UY=new A.aX("M\xeer Bedirxan m\xeer\xea M\xeergeha Botan\xea b\xfb. Serhildana w\xee ya 1847an wek berxwedaneke gir\xeeng a kurd\xee li dij\xee Osmaniyan di d\xeerok\xea de cih girtiye.","M\xeer Bedirxan, Botan M\xeerli\u011fi'nin beyiydi. 1847'deki ayaklanmas\u0131 Osmanl\u0131'ya kar\u015f\u0131 \xf6nemli bir K\xfcrt direni\u015fi olarak tarihe ge\xe7mi\u015ftir.")
B.VC=new A.aX("Qesra \xceshaq Pa\u015fa li n\xeaz\xeek\xee bajar\xea Baz\xeed (Do\u011fubayaz\u0131t) e. Ev qesra ku di sedsala 18an de hat\xee temamkirin, bandora m\xeemariya Osman\xee, Sel\xe7\xfbk\xee \xfb her\xeam\xee dihew\xeene.","\u0130shak Pa\u015fa Saray\u0131, Do\u011fubayaz\u0131t (Baz\xeed) yak\u0131nlar\u0131ndad\u0131r. 18. y\xfczy\u0131lda tamamlanan saray; Osmanl\u0131, Sel\xe7uklu ve yerel mimarinin etkilerini ta\u015f\u0131yan g\xf6rkemli bir yap\u0131d\u0131r.")
B.VE=new A.aX("Pira Malabad\xee li ser \xc7em\xea Batman\xea ye. Ev pira ku di sedsala 12an de di dema Artuqiyan de hat\xee \xe7\xeakirin, xwed\xee yek ji kemer\xean kevir\xee y\xean her\xee fireh \xean c\xeehan\xea ye.","Malabadi K\xf6pr\xfcs\xfc, Batman \xc7ay\u0131 \xfczerindedir. 12. y\xfczy\u0131lda Artuklular d\xf6neminde yap\u0131lan k\xf6pr\xfc, d\xfcnyan\u0131n en geni\u015f ta\u015f kemerlerinden birine sahiptir.")
B.W_=new A.aX("\u015eerefname di sala 1597an de ji aliy\xea \u015eerefxan\xea Bedl\xees\xee ve hatiye niv\xees\xeen. Wek yek ji \xe7avkaniy\xean yekem \xean berfireh \xean d\xeeroka kurd\xee t\xea hesibandin.","\u015eerefname'yi 1597'de Bitlisli \u015eeref Han (\u015eerefxan\xea Bedl\xees\xee) yazm\u0131\u015ft\u0131r. K\xfcrt tarihinin ilk kapsaml\u0131 yaz\u0131l\u0131 kaynaklar\u0131ndan biri kabul edilir.")
B.Ur=new A.aX("\xc7iyay\xea her\xee bilind \xea Tirkiyey\xea \xc7iyay\xea Agir\xee ye. Ev \xe7iyay\xea ku li rojhilat\xea Anatoliy\xea ye, volkaneke vemir\xee ye.","T\xfcrkiye'nin en y\xfcksek da\u011f\u0131 A\u011fr\u0131 Da\u011f\u0131'd\u0131r (\xc7iyay\xea Agir\xee). Do\u011fu Anadolu'da yer alan da\u011f, s\xf6nm\xfc\u015f bir yanarda\u011fd\u0131r.")
B.VV=new A.aX("Bilindahiya \xc7iyay\xea Agir\xee n\xeaz\xeek\xee 5.137 metre ye; ev w\xea dike l\xfbtkeya her\xee bilind a Tirkiyey\xea.","A\u011fr\u0131 Da\u011f\u0131'n\u0131n y\xfcksekli\u011fi yakla\u015f\u0131k 5.137 metredir; bu da onu T\xfcrkiye'nin en y\xfcksek zirvesi yapar.")
B.UH=new A.aX("Gola her\xee mezin a Tirkiyey\xea Gola Wan\xea ye. Bi ava xwe ya soday\xee (xw\xeay\xee) t\xea naskirin \xfb hewzeke girt\xee ye.","T\xfcrkiye'nin en b\xfcy\xfck g\xf6l\xfc Van G\xf6l\xfc'd\xfcr (Gola Wan\xea). Sodal\u0131 (tuzlu) yap\u0131s\u0131yla bilinen kapal\u0131 bir havzad\u0131r.")
B.VO=new A.aX("\xc7em\xea D\xeecle di bajar\xea Amed\xea (Diyarbak\u0131r) re derbas dibe. Yek ji du \xe7em\xean mezin \xean Mezopotamyay\xea ye.","Dicle Nehri (\xc7em\xea D\xeecle), Diyarbak\u0131r (Amed) \u015fehrinden ge\xe7er. Mezopotamya'n\u0131n iki b\xfcy\xfck nehrinden biridir.")
B.UG=new A.aX('Du \xe7em\xean mezin \xean Mezopotamyay\xea D\xeecle \xfb Ferat in. Nav\xea "Mezopotamya" bi yewnan\xee t\xea wateya "navbera du \xe7eman".','Mezopotamya\'n\u0131n iki b\xfcy\xfck nehri Dicle ve F\u0131rat\'t\u0131r (D\xeecle \xfb Ferat). "Mezopotamya" ad\u0131 Yunanca "iki nehir aras\u0131" anlam\u0131na gelir.')
B.UP=new A.aX("Hewl\xear paytexta Her\xeama Kurdistan\xea ya Iraq\xea ye. Bi keleha xwe ya d\xeerok\xee navdar e ku wek yek ji bajar\xean her\xee kevn \xean c\xeehan\xea t\xea hesibandin.","Hewl\xear (Erbil), Irak K\xfcrdistan B\xf6lgesi'nin ba\u015fkentidir. D\xfcnyan\u0131n kesintisiz yerle\u015filen en eski \u015fehirlerinden say\u0131lan tarih\xee kalesiyle \xfcnl\xfcd\xfcr.")
B.VK=new A.aX("Sil\xeaman\xee bajarek\xee kurd\xee ye li Iraq\xea. Bi navenda \xe7and \xfb edebiyat\xea b\xfbna xwe t\xea naskirin.","S\xfcleymaniye (Sil\xeaman\xee), Irak'ta yer alan bir K\xfcrt \u015fehridir. K\xfclt\xfcr ve edebiyat merkezi olmas\u0131yla tan\u0131n\u0131r.")
B.UU=new A.aX("Gola Urmiy\xea li \xceran\xea ye. Ber\xea gola her\xee mezin a \xceran\xea b\xfb; di sal\xean daw\xee de bi pirran\xee ziwa b\xfbye.","Urmiye G\xf6l\xfc (Gola Urmiy\xea), \u0130ran'da yer al\u0131r. \u0130ran'\u0131n en b\xfcy\xfck g\xf6l\xfcyd\xfc; son y\u0131llarda b\xfcy\xfck \xf6l\xe7\xfcde kurumu\u015ftur.")
B.Ut=new A.aX("S\xfbr\xean Amed\xea bi dir\xeajahiya xwe ya n\xeaz\xeek\xee 5,8 k\xeelometreyan t\xean hesibandin yek ji s\xfbr\xean her\xee dir\xeaj \xean c\xeehan\xea, pi\u015ft\xee S\xfbra Mezin a \xc7\xeen\xea.","Diyarbak\u0131r Surlar\u0131 yakla\u015f\u0131k 5,8 kilometre uzunlu\u011fuyla, \xc7in Seddi'nin ard\u0131ndan d\xfcnyan\u0131n en uzun sur duvarlar\u0131ndan biri kabul edilir.")
B.VX=new A.aX('S\xfbr\xean Amed\xea \xfb Bax\xe7ey\xean Hevsel\xea di sala 2015an de ketin l\xeesteya M\xeerateya C\xeehan\xea ya UNESCOy\xea, wek "Peyzajeke \xc7and\xee".','Diyarbak\u0131r Surlar\u0131 ve Hevsel Bah\xe7eleri, 2015\'te "K\xfclt\xfcrel Peyzaj" kategorisinde UNESCO D\xfcnya Miras\u0131 listesine girmi\u015ftir.')
B.VL=new A.aX("\u015eerefname yekem \xe7avkaniya berfireh e ku d\xeerok \xfb binemal\xean m\xeergeh\xean kurd\xee bi awayek\xee s\xeestemat\xeek vedib\xeaje; ji ber v\xea yek\xea wek belgeya bingeh\xeen a d\xeeroknasiya kurd\xee t\xea binavkirin.","\u015eerefname, K\xfcrt beyliklerinin tarihini ve soy k\xfct\xfc\u011f\xfcn\xfc sistematik bi\xe7imde ele alan ilk kapsaml\u0131 kaynakt\u0131r; bu nedenle K\xfcrt tarih\xe7ili\u011finin temel belgesi say\u0131l\u0131r.")
B.V4=new A.aX("Selahed\xeen\xea Ey\xfbb\xee li Tikr\xeet\xea ji dayik b\xfbye \xfb pi\u015ft\xee \u015eer\xea H\xeett\xeen\xea Qudis ji Xa\xe7perestan girt (1187); ev b\xfbyer bandoreke mezin li ser d\xeeroka Rojhilata Nav\xeen hi\u015ftiye.","K\xfcrt k\xf6kenli Selahaddin Eyyubi, Tikrit do\u011fumludur ve H\u0131ttin Sava\u015f\u0131'n\u0131n ard\u0131ndan 1187'de Kud\xfcs'\xfc Ha\xe7l\u0131lardan geri alm\u0131\u015ft\u0131r; bu olay Orta Do\u011fu tarihinde derin iz b\u0131rakm\u0131\u015ft\u0131r.")
B.Vg=new A.aX("Selahed\xeen\xea Ey\xfbb\xee li ser xerabey\xean Fatimiyan Dewleta Ey\xfbbiyan ava kir \xfb b\xfb yekem sultan\xea w\xea.","Selahaddin Eyyubi, Fat\u0131mi Devleti'nin y\u0131k\u0131nt\u0131lar\u0131 \xfczerine Eyyubi Devleti'ni kurmu\u015f ve onun ilk sultan\u0131 olmu\u015ftur.")
B.VN=new A.aX("Dewleta Ey\xfbbiyan di sedsala 12an \xfb 13an de li Misr\xea, \u015eam\xea \xfb be\u015f\xean din \xean Rojhilata Nav\xeen desthilat b\xfb, heta ku Meml\xfbkan cih girtin.","Eyyubi Devleti, 12. ve 13. y\xfczy\u0131llarda M\u0131s\u0131r, \u015eam ve Orta Do\u011fu'nun di\u011fer b\xf6lgelerinde h\xfck\xfcm s\xfcrm\xfc\u015f, yerini Meml\xfcklere b\u0131rakm\u0131\u015ft\u0131r.")
B.Vx=new A.aX("M\xeergeha Erdelan\xea yek ji \xe7ar m\xeergeh\xean mezin \xean kurd\xee b\xfb (digel Botan, Baban \xfb Soran) \xfb navenda w\xea Sine (Senendec, \xeero li \xceran\xea) b\xfb.","Erdelan Beyli\u011fi, Botan, Baban ve Soran ile birlikte d\xf6rt b\xfcy\xfck K\xfcrt beyli\u011finden biriydi; merkezi bug\xfcn \u0130ran'da bulunan Sine (Senendec) idi.")
B.UF=new A.aX("Kelheya Hewl\xear\xea li ser girek\xee ye ku bi hezaran salan e b\xeay\xee navber t\xea ni\u015fteciy\xee; ji ber v\xea taybetiy\xea wek yek ji bajar\xean her\xee kevn \xean c\xeehan\xea t\xea zan\xeen.","Erbil Kalesi, binlerce y\u0131ld\u0131r kesintisiz olarak yerle\u015fim g\xf6ren bir h\xf6y\xfck \xfczerine kuruludur; bu \xf6zelli\u011fiyle d\xfcnyan\u0131n en eski \u015fehirlerinden biri olarak bilinir.")
B.VP=new A.aX("Kelheya Hewl\xear\xea di sala 2014an de ket l\xeesteya M\xeerateya C\xeehan\xea ya UNESCOy\xea.","Erbil Kalesi, 2014 y\u0131l\u0131nda UNESCO D\xfcnya Miras\u0131 listesine girmi\u015ftir.")
B.V_=new A.aX("Komara Mehabad\xea di 22\xea R\xeabendana 1946an de li \xceran\xea hat ragihandin \xfb ten\xea \xe7end meh domand; wek yekem tecr\xfbbeya dewleta kurd\xee ya n\xfbjen t\xea binavkirin.","Mahabad Cumhuriyeti, 22 Ocak 1946'da \u0130ran'da ilan edilmi\u015f ve yaln\u0131zca birka\xe7 ay ayakta kalabilmi\u015ftir; modern anlamda ilk K\xfcrt devlet deneyimi olarak an\u0131l\u0131r.")
B.UO=new A.aX("Qaz\xee Mihemed serok\xea Komara Mehabad\xea b\xfb; pi\u015ft\xee hilwe\u015f\xeena komar\xea di 1947an de hat darvekirin.","Qaz\xee Mihemed, Mahabad Cumhuriyeti'nin cumhurba\u015fkan\u0131yd\u0131; cumhuriyetin \xe7\xf6k\xfc\u015f\xfcnden sonra 1947'de idam edilmi\u015ftir.")
B.Vc=new A.aX("M\xeard\xeen bi avahiy\xean xwe y\xean ji kevir\xea zer \xea tira\u015fand\xee, ku li ser girek\xee li dora De\u015fta Mezopotamyay\xea hatine ristin, navdar e.","Mardin, Mezopotamya ovas\u0131na bakan bir tepeye s\u0131ralanm\u0131\u015f, sar\u0131 kesme ta\u015ftan yap\u0131lar mimarisiyle \xfcnl\xfcd\xfcr.")
B.VZ=new A.aX("Hesk\xeefa kevnar li k\xealeka \xc7em\xea D\xeecle b\xfb; be\u015feke mezin a baj\xear pi\u015ft\xee \xe7\xeab\xfbna Bendava Il\xees\xfby\xea di bin av\xea de maye.","Tarihi Hasankeyf, Dicle Nehri k\u0131y\u0131s\u0131nda yer al\u0131yordu; kentin b\xfcy\xfck b\xf6l\xfcm\xfc Il\u0131su Baraj\u0131'n\u0131n olu\u015fturdu\u011fu g\xf6l alt\u0131nda kalm\u0131\u015ft\u0131r.")
B.W3=new A.aX('Mezopotamya, li navbera D\xeecle \xfb Ferat de, yek ji cih\xean p\xea\u015f\xee y\xea \xe7andiniy\xea \xfb bajar\xeeb\xfbn\xea ye \xfb bi nav\xea "Landa Du \xc7eman" t\xea zan\xeen.',"Mezopotamya, Dicle ile F\u0131rat nehirleri aras\u0131nda yer al\u0131r; tar\u0131m\u0131n ve \u015fehirle\u015fmenin ilk merkezlerinden biridir.")
B.W1=new A.aX('Nav\xea "Mezopotamya" ji yewnaniya kevn t\xea, "mesos" (navber) \xfb "potamos" (\xe7em) l\xea hatiye z\xeadekirin.','"Mezopotamya" ad\u0131 Eski Yunancadan gelir; "mesos" (ara) ve "potamos" (nehir) s\xf6zc\xfcklerinden t\xfcretilmi\u015ftir.')
B.VD=new A.aX("M\xeergeha Soran yek ji \xe7ar m\xeergeh\xean mezin \xean kurd\xee b\xfb; navenda w\xea Rewandiz b\xfb, li her\xeameke \xe7iyay\xee ya dijwar a Kurdistana Iraq\xea.","Soran Beyli\u011fi, d\xf6rt b\xfcy\xfck K\xfcrt beyli\u011finden biriydi; merkezi, Irak K\xfcrdistan\u0131'n\u0131n da\u011fl\u0131k ve ula\u015f\u0131m\u0131 zor bir b\xf6lgesinde bulunan Rewandiz'di (Rawanduz).")
B.Vw=new A.aX("Pad\xee\u015fahiya Urart\xfb (sedsala 9-6an B.Z.) li dora Gola Wan\xea hate avakirin \xfb paytexta w\xea Tu\u015fpa b\xfb, li cih\xea Wan\xea ya \xeero.","Urartu Krall\u0131\u011f\u0131 (M\xd6 9-6. y\xfczy\u0131llar) Van G\xf6l\xfc \xe7evresinde kurulmu\u015ftur; ba\u015fkenti g\xfcn\xfcm\xfcz Van kentinin bulundu\u011fu Tu\u015fpa'yd\u0131.")
B.Us=new A.aX('"Amed" nav\xea kurd\xee y\xea Diyarbekir\xea ye; herdu nav j\xee li her\xeam\xea bi awayek\xee berfireh t\xean bikaran\xeen.','"Amed", Diyarbak\u0131r\'\u0131n K\xfcrt\xe7e ad\u0131d\u0131r; her iki isim de b\xf6lgede yayg\u0131n bi\xe7imde kullan\u0131l\u0131r.')
B.V3=new A.aX("Avakirina Qesra \xceshaq Pa\u015fa n\xeaz\xeek\xee sed salan domand \xfb di sala 1784an de ji aliy\xea malbata m\xeer\xean Baz\xeed\xea ve hate temamkirin.","\u0130shak Pa\u015fa Saray\u0131'n\u0131n in\u015fas\u0131 yakla\u015f\u0131k y\xfcz y\u0131l s\xfcrm\xfc\u015f ve 1784'te Do\u011fubayaz\u0131t beyleri ailesi taraf\u0131ndan tamamlanm\u0131\u015ft\u0131r.")
B.Uu=new A.aX("\xcemparatoriya Medan li Zagros\xea (rojavay\xea \xceran\xea) derket hol\xea \xfb bi hevkariya Bab\xeeliyan \xcemparatoriya As\xfbr\xee hilwe\u015fand (612 B.Z.).","Med \u0130mparatorlu\u011fu, Zagros b\xf6lgesinde (\u0130ran'\u0131n bat\u0131s\u0131) ortaya \xe7\u0131km\u0131\u015f ve Babilliler ile birlikte Asur \u0130mparatorlu\u011fu'nu y\u0131km\u0131\u015ft\u0131r (M\xd6 612).")
B.V7=new A.aX("M\xeergeha Baban \xe7arem\xeen m\xeergeha mezin a kurd\xee b\xfb; m\xeer\xea w\xea \xcebrah\xeem Pa\u015fa Sil\xeaman\xee wek navenda xwe ava kir.","Baban Beyli\u011fi, d\xf6rd\xfcnc\xfc b\xfcy\xfck K\xfcrt beyli\u011fiydi; beyi \u0130brahim Pa\u015fa, S\xfcleymaniye'yi kendi merkezleri olarak in\u015fa etmi\u015ftir.")
B.UM=new A.aX("Sil\xeaman\xee di 1784an de ji aliy\xea \xcebrah\xeem Pa\u015fay\xea Baban\xee ve wek navenda m\xeergeh\xea hate avakirin.","S\xfcleymaniye, 1784'te Baban Beyi \u0130brahim Pa\u015fa taraf\u0131ndan beyli\u011fin merkezi olarak kurulmu\u015ftur.")
B.UK=new A.aX("Birca Ke\xe7\xee birc\xea her\xee navdar \xea s\xfbr\xean Amed\xea ye; nav\xea w\xea ji peyker\xean bizinan \xean li ser d\xeew\xear t\xea.","Ke\xe7i Burcu (Birca Ke\xe7\xee), Diyarbak\u0131r Surlar\u0131'n\u0131n en bilinen burcudur; ad\u0131n\u0131 duvar \xfczerindeki ke\xe7i kabartmalar\u0131ndan al\u0131r.")
B.VH=new A.aX("Pad\xee\u015fah\xean Urart\xfb niv\xees\xean xwe bi t\xeep\xean mix\xee y\xean bi ziman\xea Urart\xee li kevir hi\u015ftine; piraniya wan li dora Gola Wan\xea hatine d\xeetin.","Urartu krallar\u0131, Urartuca \xe7ivi yaz\u0131s\u0131yla kayalara yaz\u0131tlar b\u0131rakt\u0131; bunlar\u0131n \xe7o\u011fu Van G\xf6l\xfc \xe7evresinde bulunmu\u015ftur.")
B.V8=new A.aX("Xirabre\u015fk (G\xf6bekli Tepe), n\xeaz\xeek\xee Rihay\xea, yek ji kevintir\xeen perestgeh\xean mirovahiy\xea ye (n\xeaz\xeek\xee 9.600 B.Z.) \xfb di 2018an de ket l\xeesteya UNESCOy\xea.","G\xf6bekli Tepe, Urfa (Riha) yak\u0131nlar\u0131nda yer alan ve insanl\u0131\u011f\u0131n bilinen en eski tap\u0131nak yap\u0131lar\u0131ndan biridir (M\xd6 yakla\u015f\u0131k 9.600); 2018'de UNESCO listesine girmi\u015ftir.")
B.UT=new A.aX('Di edebiyata kurd\xee de "\xe7\xeerok" \xe7\xeeroka kurt a pex\u015fan e. B\xfbyer, karakter \xfb peyamek\xea di forma kurt de digih\xeene; kevne\u015fopiya devk\xee ya kurd\xee dewlemend e bi \xe7\xeerok\xean gel\xear\xee.','K\xfcrt edebiyat\u0131nda "\xe7\xeerok" k\u0131sa \xf6yk\xfc/hik\xe2ye demektir. Olay, karakter ve bir mesaj\u0131 k\u0131sa bi\xe7imde aktar\u0131r; K\xfcrt s\xf6zl\xfc gelene\u011fi halk hik\xe2yeleriyle zengindir.')
B.VI=new A.aX('Di edebiyata kurd\xee de "helbest" t\xea wateya \u015fi\xeer\xea. Bi p\xeevan, kafiye \xfb hestan ve gir\xeaday\xee ye; helbestvan\xean klas\xeek wek Melay\xea Ciz\xeer\xee \xfb Ehmed\xea Xan\xee ev huner bilind kirine.','K\xfcrt edebiyat\u0131nda "helbest" \u015fiir anlam\u0131na gelir. \xd6l\xe7\xfc, kafiye ve duyguyla ili\u015fkilidir; Melay\xea Ciz\xeer\xee ve Ehmed\xea Xan\xee gibi klasik \u015fairler bu sanat\u0131 y\xfckseltmi\u015ftir.')
B.Vd=new A.aX('Di edebiyata kurd\xee de "destan" \xe7\xeeroka dir\xeaj a qehreman\xee ye. B\xfbyer\xean mezin, \u015fer \xfb lehengan vedib\xeaje; "Mem\xea Alan" yek ji destan\xean navdar \xean kurd\xee ye.','K\xfcrt edebiyat\u0131nda "destan", kahramanl\u0131k anlatan uzun bir anlat\u0131d\u0131r. B\xfcy\xfck olaylar\u0131, sava\u015flar\u0131 ve kahramanlar\u0131 anlat\u0131r; "Mem\xea Alan" \xfcnl\xfc K\xfcrt destanlar\u0131ndan biridir.')
B.Vn=new A.aX('Di edebiyat\xea de "mecaz" wateya rast a peyv\xea nay\xea, wateyeke veguh\xeaz bikar t\xeene. Wek gotina "\u015f\xear" ji bo mirov\xea w\xearek; ji bo h\xeaz \xfb bandor\xea t\xea xebitandin.','Edebiyatta "mecaz", bir s\xf6zc\xfc\u011f\xfcn ger\xe7ek anlam\u0131n\u0131 de\u011fil aktar\u0131lm\u0131\u015f anlam\u0131n\u0131 kullanmakt\u0131r. "Aslan" s\xf6z\xfcn\xfc yi\u011fit biri i\xe7in kullanmak gibi; anlat\u0131ma g\xfc\xe7 ve etki katar.')
B.VQ=new A.aX('Di helbest\xea de "kafiye" lihevhatina dengan e li dawiya r\xeazan. Awaz \xfb ahenga \u015fi\xeer\xea xurt dike \xfb di b\xeera mirovan de h\xeasantir dim\xeene.','\u015eiirde "kafiye", dize sonlar\u0131ndaki ses uyumudur. \u015eiirin ahengini g\xfc\xe7lendirir ve ak\u0131lda kalmas\u0131n\u0131 kolayla\u015ft\u0131r\u0131r.')
B.VJ=new A.aX("Ehmed\xea Xan\xee bi Kurmanc\xee niv\xees\xee da ku ziman\xea kurd\xee di edebiyata klas\xeek de cihek\xee h\xeaja bigire; Mem \xfb Z\xeen h\xea j\xee wek serp\xeahatiya edebiyata kurd\xee t\xea d\xeetin.","Ehmed\xea Xan\xee, K\xfcrt\xe7enin klasik edebiyatta sayg\u0131n bir yer edinmesi i\xe7in Kurmanci yazm\u0131\u015ft\u0131r; Mem \xfb Z\xeen h\xe2l\xe2 K\xfcrt edebiyat\u0131n\u0131n ba\u015fyap\u0131t\u0131 say\u0131l\u0131r.")
B.Vj=new A.aX("Mem \xfb Z\xeen mesnewiyeke dir\xeaj a bi helbest e ku Ehmed\xea Xan\xee di 1695an de li Baz\xeed\xea niv\xeesiye.","Mem \xfb Z\xeen, Ehmed\xea Xan\xee'nin 1695'te Do\u011fubayaz\u0131t'ta (Baz\xeed) kaleme ald\u0131\u011f\u0131 uzun bir mesnevidir.")
B.UJ=new A.aX("Xan\xee berhema xwe di sala 1695an de, li bin \xe7avd\xeariya m\xeer\xean Baz\xeed\xea, qedand.","Xan\xee, eserini Baz\xeed (Do\u011fubayaz\u0131t) beylerinin himayesinde 1695'te tamamlam\u0131\u015ft\u0131r.")
B.Uz=new A.aX("Di \xe7\xeeroka Mem \xfb Z\xeen\xea de ev\xeena du dilan bi dil\u015fikestin diqede; Xan\xee di p\xea\u015fgotina xwe de v\xea ev\xeen\xea wek sembola per\xe7eb\xfbn \xfb b\xeayek\xeetiya kurdan j\xee dinirx\xeene.","Mem ile Z\xeen'in a\u015fk\u0131 hik\xe2yede trajik bi\xe7imde sona erer; Xan\xee \xf6ns\xf6z\xfcnde bu a\u015fk\u0131, K\xfcrtlerin b\xf6l\xfcnm\xfc\u015fl\xfc\u011f\xfcn\xfcn bir simgesi olarak da yorumlar.")
B.UA=new A.aX("Mem\xea Alan destaneke gel\xear\xee ya devk\xee ye ku ber\xee Xan\xee j\xee di nav gel de dihat gotin; Xan\xee ev materyal wergirt \xfb w\xea bi awayek\xee edeb\xee y\xea bilind niv\xees\xee.","Mem\xea Alan, Xan\xee'den \xf6nce de halk aras\u0131nda s\xf6zl\xfc olarak anlat\u0131lan bir destand\u0131r; Xan\xee bu malzemeyi al\u0131p y\xfcksek edeb\xee bir bi\xe7imde yeniden yazm\u0131\u015ft\u0131r.")
B.V5=new A.aX("Melay\xea Ciz\xeer\xee di sedsala 16-17an de li Ciz\xeer\xea jiyaye \xfb D\xeewana xwe ya bi helbest\xean tesewif\xee wek yek ji l\xfbtkey\xean helbesta klas\xeek a Kurmanc\xee t\xea hesibandin.","16-17. y\xfczy\u0131lda Cizre'de ya\u015fam\u0131\u015f olan Melay\xea Ciz\xeer\xee'nin tasavvuf\xee \u015fiirlerden olu\u015fan D\xeewan'\u0131, klasik Kurmanci \u015fiirinin doruklar\u0131ndan biri say\u0131l\u0131r.")
B.UE=new A.aX("Feqiy\xea Teyran (sedsala 17an) di helbest\xean xwe de pir caran bi teyran re diaxive; ev \u015f\xeawaz t\xeakiliya w\xee ya n\xeaz\xeek bi xwezay\xea re n\xee\u015fan dide.","17. y\xfczy\u0131l \u015fairi Feqiy\xea Teyran, \u015fiirlerinde s\u0131k\xe7a ku\u015flarla konu\u015fur; bu \xfcslup, do\u011fayla kurdu\u011fu yak\u0131n ba\u011f\u0131 yans\u0131t\u0131r.")
B.Vq=new A.aX('Nav\xea w\xee y\xea \u015fi\'r\xee "Feqiy\xea Teyran" t\xea wateya "feq\xeeh\xea teyran" (y\xea ku ziman\xea teyran dizane); efsaneyek dib\xeaje w\xee ji zaroktiy\xea ve bi teyran re dipeyiv\xee.','Mahlas\u0131 "ku\u015flar\u0131n fakihi" (ku\u015flar\u0131n dilini bilen) anlam\u0131na gelir; bir efsaneye g\xf6re \xe7ocuklu\u011fundan beri ku\u015flarla konu\u015fabildi\u011fi s\xf6ylenir.')
B.VT=new A.aX("Celadet Al\xee Bedirxan, biray\xea xwe Kamiran re, kovara Hawar derxist da ku ziman \xfb \xe7anda kurd\xee bi niv\xeesk\xee bij\xee \xfb p\xea\u015f bikeve.","Celadet Al\xee Bedirxan, karde\u015fi Kamiran ile birlikte, K\xfcrt dilinin ve k\xfclt\xfcr\xfcn\xfcn yaz\u0131yla ya\u015famas\u0131 ve geli\u015fmesi i\xe7in Hawar dergisini \xe7\u0131karm\u0131\u015ft\u0131r.")
B.US=new A.aX("Hawar di 1932an de li \u015eam\xea dest bi we\u015fan\xea kir \xfb di d\xeeroka ziman\xea kurd\xee de gaveke gir\xeeng b\xfb, ji ber ku alfabeya Lat\xeen\xee ya Kurmanc\xee j\xea belav b\xfb.","Hawar, 1932'de \u015eam'da yay\u0131n hayat\u0131na ba\u015flam\u0131\u015f ve Kurmanci Latin alfabesini yayg\u0131nla\u015ft\u0131rd\u0131\u011f\u0131 i\xe7in K\xfcrt dili tarihinde \xf6nemli bir ad\u0131m olmu\u015ftur.")
B.Vy=new A.aX("Malbata Bedirxan pi\u015ft\xee hilwe\u015f\xeena Osmaniyan sirg\xfbn\xee S\xfbriy\xea b\xfbb\xfb; ji ber v\xea yek\xea Hawar li \u015eam\xea, ne li welat\xea kurdan, dihat we\u015fandin.","Bedirxan ailesi Osmanl\u0131'n\u0131n \xe7\xf6k\xfc\u015f\xfcn\xfcn ard\u0131ndan Suriye'ye s\xfcrg\xfcn edilmi\u015fti; bu y\xfczden Hawar, K\xfcrt topraklar\u0131nda de\u011fil \u015eam'da yay\u0131mlan\u0131yordu.")
B.VR=new A.aX("Celadet Al\xee Bedirxan di 1932an de li ser bingeha t\xeep\xean Lat\xeen\xee alfabeyeke ji bo Kurmanc\xee amade kir; ev alfabe h\xea j\xee li Tirkiye, S\xfbriye \xfb dervey\xee wel\xeat t\xea bikaran\xeen.","Celadet Al\xee Bedirxan, 1932'de Latin harflerine dayal\u0131 bir Kurmanci alfabesi haz\u0131rlam\u0131\u015ft\u0131r; bu alfabe bug\xfcn de T\xfcrkiye, Suriye ve diaspora ortamlar\u0131nda kullan\u0131lmaktad\u0131r.")
B.W2=new A.aX("Cegerxw\xeen (1903-1984) bi hezaran helbest\xean xwe y\xean li ser ev\xeen, welatpar\xeaz\xee \xfb t\xeako\u015f\xeena civak\xee bi kurd\xee niv\xeesiye; wek yek ji helbestvan\xean her\xee h\xeaja y\xean sedsala 20an t\xea zan\xeen.","Cegerxw\xeen (1903-1984), a\u015fk, vatanseverlik ve toplumsal m\xfccadele \xfczerine yazd\u0131\u011f\u0131 binlerce \u015fiirle 20. y\xfczy\u0131l\u0131n en \xf6nemli K\xfcrt \u015fairlerinden biri say\u0131l\u0131r.")
B.UI=new A.aX('Nav\xea rast\xeen \xea Cegerxw\xeen \u015e\xeaxm\xfbs Hesen e; "Cegerxw\xeen" (ciger + xw\xeen, "kanayan ci\u011fer") wek nav\xea helbest\xee hatiye hilbijartin.',"Cegerxw\xeen'in as\u0131l ad\u0131 \u015e\xeaxm\xfbs Hesen'dir; \"Cegerxw\xeen\" (kanayan ci\u011fer) sonradan benimsenen bir \u015fair mahlas\u0131d\u0131r.")
B.VY=new A.aX("Mehmed Uzun (1953-2007) di sirg\xfbn\xea de li Sw\xead\xea bi Kurmanc\xee roman niv\xees\xee \xfb wek damezr\xeener\xea romana kurd\xee ya n\xfbjen t\xea hesibandin.","Mehmed Uzun (1953-2007), \u0130sve\xe7'teki s\xfcrg\xfcn y\u0131llar\u0131nda Kurmanci roman yazm\u0131\u015f ve modern K\xfcrt roman\u0131n\u0131n kurucular\u0131ndan biri olarak kabul edilir.")
B.V6=new A.aX('"Siya Ev\xeen\xea" (Ev\xeen\xea Siya) yek ji roman\xean navdar \xean Mehmed Uzun e; bi Kurmanc\xee hatiye niv\xees\xeen \xfb pa\u015f\xea ji gelek zimanan ve hatiye wergerandin.','"Siya Ev\xeen\xea" (A\u015fk\u0131n G\xf6lgesi), Mehmed Uzun\'un tan\u0131nm\u0131\u015f romanlar\u0131ndan biridir; Kurmanci yaz\u0131lm\u0131\u015f ve sonradan bir\xe7ok dile \xe7evrilmi\u015ftir.')
B.W0=new A.aX("Uzun, di dema ku Kurmanc\xee li Tirkiyey\xea qedexe b\xfb de, bi hi\u015fmend\xee roman\xean xwe bi v\xee ziman\xee niv\xees\xee da ku edebiyata kurd\xee ya n\xfbjen ava bike.","Uzun, Kurmancinin T\xfcrkiye'de yasakl\u0131 oldu\u011fu d\xf6nemde, bilin\xe7li olarak romanlar\u0131n\u0131 bu dilde yazarak modern K\xfcrt edebiyat\u0131n\u0131 in\u015fa etmeye \xe7al\u0131\u015fm\u0131\u015ft\u0131r.")
B.V0=new A.aX("El\xee Her\xeer\xee bi gelemper\xee wek yek ji p\xea\u015feng\xean her\xee p\xea\u015f\xee y\xean helbesta klas\xeek a Kurmanc\xee (dor. sedsala 11an) t\xea binavkirin, her \xe7end agahiy\xean li ser jiyana w\xee t\xearker nebin j\xee.","El\xee Her\xeer\xee, ya\u015fam\u0131na dair kesin bilgiler s\u0131n\u0131rl\u0131 olsa da genellikle klasik Kurmanci \u015fiirinin en erken temsilcilerinden biri (yakla\u015f\u0131k 11. y\xfczy\u0131l) olarak an\u0131l\u0131r.")
B.VF=new A.aX('Destan celebeke edebiyata devk\xee ya dir\xeaj e ku serp\xeahatiy\xean lehengan, \u015fer \xfb ev\xeenan bi awayek\xee p\xeevankir\xee vedib\xeaje; li Kurdistan\xea "Mem\xea Alan" \xfb "Kela Dimdim" m\xeenak\xean navdar in.','Destan, kahramanlar\u0131n, sava\u015flar\u0131n ve a\u015fklar\u0131n \xf6l\xe7\xfcl\xfc bi\xe7imde anlat\u0131ld\u0131\u011f\u0131 uzun bir s\xf6zl\xfc edebiyat t\xfcr\xfcd\xfcr; K\xfcrtler aras\u0131nda "Mem\xea Alan" ve "Kela Dimdim" bilinen \xf6rneklerdir.')
B.VB=new A.aX('Di muz\xeeka kurd\xee de "stran" t\xea wateya kilam/stran\xea. Dikare ev\xeen\xee, qehreman\xee an gel\xear\xee be; dengb\xeaj \xfb hunermend wan ji nif\u015f\xea re dav\xeajin.','K\xfcrt m\xfczi\u011finde "stran" \u015fark\u0131/t\xfcrk\xfc demektir. A\u015fk, kahramanl\u0131k ya da halk temal\u0131 olabilir; dengb\xeajler ve sanat\xe7\u0131lar bunlar\u0131 ku\u015faklara aktar\u0131r.')
B.UB=new A.aX('Di muz\xeeka kurd\xee de "def" sazeke l\xeadan\xea ye (def/bend\xeer). Di govend \xfb \u015fahiyan de ritm\xea dide \xfb pir\xee caran bi erbaney\xea re t\xea xebitandin.','K\xfcrt m\xfczi\u011finde "def" vurmal\u0131 bir \xe7alg\u0131d\u0131r (bendir/tef). Halaylarda ve \u015fenliklerde ritmi verir, \xe7o\u011fu zaman erbane ile birlikte kullan\u0131l\u0131r.')
B.VS=new A.aX('Di muz\xeeka kurd\xee de "erbane" sazeke l\xeadan\xea ya dor e (def a mezin). Di dawet \xfb d\xeelanan de ritma bingeh\xeen peyda dike.','K\xfcrt m\xfczi\u011finde "erbane", yuvarlak vurmal\u0131 bir \xe7alg\u0131d\u0131r (b\xfcy\xfck tef). D\xfc\u011f\xfcn ve halaylarda temel ritmi sa\u011flar.')
B.Uv=new A.aX('Di muz\xeeka kurd\xee de "temb\xfbr" sazeke bi t\xeal e. Bi taybet\xee di muz\xeeka ol\xee \xfb a\u015fiq\xee de t\xea bikaran\xeen \xfb deng\xea w\xea y\xea k\xfbr navdar e.','K\xfcrt m\xfczi\u011finde "temb\xfbr" telli bir \xe7alg\u0131d\u0131r. \xd6zellikle din\xee ve \xe2\u015f\u0131k m\xfczi\u011finde kullan\u0131l\u0131r ve derin t\u0131n\u0131s\u0131yla bilinir.')
B.VG=new A.aX('"Jin, Jiyan, Azad\xee" dir\xfb\u015fmeke navdar e; t\xea de "jin" t\xea wateya "kad\u0131n". Peyv bi "jiyan" (hayat) \xfb "azad\xee" (\xf6zg\xfcrl\xfck) re t\xea bikaran\xeen.','"Jin, Jiyan, Azad\xee" bilinen bir slogand\u0131r; buradaki "jin" K\xfcrt\xe7ede "kad\u0131n" demektir. S\xf6z "jiyan" (hayat) ve "azad\xee" (\xf6zg\xfcrl\xfck) s\xf6zc\xfckleriyle birlikte kullan\u0131l\u0131r.')
B.UZ=new A.aX('Peyva "azad\xee" di Kurmanc\xee de t\xea wateya "\xf6zg\xfcrl\xfck". Di gelek dir\xfb\u015fm \xfb stranan de wek nirxeke bingeh\xeen derbas dibe.','"Azad\xee" s\xf6zc\xfc\u011f\xfc K\xfcrt\xe7ede "\xf6zg\xfcrl\xfck" anlam\u0131na gelir. Bir\xe7ok slogan ve \u015fark\u0131da temel bir de\u011fer olarak ge\xe7er.')
B.V1=new A.aX('"Jineoloj\xee" wek "zanista jin\xea" t\xea p\xeanasekirin; li dora zan\xeena jin\xea \xfb rexneya baviksalariy\xea (patriyarka) ava dibe.','"Jineoloj\xee" en k\u0131sa bi\xe7imde "kad\u0131n bilimi" olarak a\xe7\u0131klan\u0131r; kad\u0131n bilgisi ve patriarka ele\u015ftirisi etraf\u0131nda kurulan bir kavramd\u0131r.')
B.Vl=new A.aX('Peyva "hevalt\xee" t\xea wateya "yolda\u015fl\u0131k/arkada\u015fl\u0131k". \xc7anda hevaltiy\xea li ser hevgirtin \xfb pi\u015ftevaniya hevd\xfb ava dibe.','"Hevalt\xee" s\xf6zc\xfc\u011f\xfc "yolda\u015fl\u0131k/arkada\u015fl\u0131k" anlam\u0131na gelir. Hevalt\xee k\xfclt\xfcr\xfc dayan\u0131\u015fma ve kar\u015f\u0131l\u0131kl\u0131 destek \xfczerine kuruludur.')
B.VA=new A.aX('T\xeag\xeena "konfederal\xeezma demokrat\xeek" ji aliy\xea Abdullah Ocalan ve hatiye p\xea\u015fxistin. Ev t\xeag\xeen li ser demokrasiya her\xeam\xee, parastina jin\xea \xfb ekolojiy\xea disekine.','"Demokratik konfederalizm" kavram\u0131 Abdullah \xd6calan taraf\u0131ndan geli\u015ftirilmi\u015ftir. Yerel demokrasi, kad\u0131n \xf6zg\xfcrl\xfc\u011f\xfc ve ekoloji vurgusuyla tan\u0131mlanan bir kavramd\u0131r.')
B.Vb=new A.aX('Wek alternat\xeefa "modern\xeeteya kap\xeetal\xeest", t\xeag\xeena "modern\xeeteya demokrat\xeek" t\xea p\xea\u015fniyarkirin. Ew rexneya navend-dewlet \xfb pergala kap\xeetal\xeest dike.','"Kapitalist modernite"ye alternatif olarak \xf6nerilen kavram "demokratik modernite"dir. Merkez\xee ulus-devlet ve kapitalist sisteme y\xf6nelik bir ele\u015ftiri i\xe7erir.')
B.Vu=new A.aX('Pergala "hevserokat\xee" n\xfbnertiya wekhev a jin \xfb m\xear \xfb bir\xeavebirina hevpar kurumsal dike. Armanc wekheviya zayend\xee ye di r\xeavebirin\xea de.','"E\u015fba\u015fkanl\u0131k" sistemi kad\u0131n-erkek e\u015fit temsili ve ortak y\xf6netimi kurumsalla\u015ft\u0131rmay\u0131 hedefler. Ama\xe7, y\xf6netimde cinsiyet e\u015fitli\u011fidir.')
B.Vt=new A.aX('Daxwaza "xweseriya demokrat\xeek" t\xea wateya ku civak kar\xfbbar\xean xwe y\xean her\xeam\xee bi xwe bir\xeave bibin. Li ser xwe-bir\xeavebirina her\xeam\xee disekine.','"Demokratik \xf6zerklik" talebi, topluluklar\u0131n yerel i\u015flerini kendilerinin y\xf6netmesini ifade eder. Yerel \xf6z-y\xf6netim vurgusu ta\u015f\u0131r.')
B.UQ=new A.aX('Daxwaza "perwerdeya bi ziman\xea dayik\xea" dikeve kategoriya maf\xean \xe7and\xee \xfb ziman\xee. Parastina ziman\xea k\xeamaniyan armanc dike.','"Anadilde e\u011fitim" talebi, k\xfclt\xfcrel ve dilsel haklar kategorisine girer. Az\u0131nl\u0131k dillerinin korunmas\u0131n\u0131 hedefler.')
B.Vm=new A.aX('"Av" di Kurmanc\xee de t\xea wateya "su". Di jiyana rojane de av jiyan e; di gotinan de j\xee (m\xeenak "av \xfb nan") bingeha xwarin\xea ye.','"Av", Kurmanc\xee\'de "su" demektir. G\xfcnl\xfck dilde temel bir kelimedir; "av \xfb nan" gibi deyimlerde de beslenmenin temelini anlat\u0131r.')
B.Ux=new A.aX('"Roj" hem "g\xfcn" hem j\xee "g\xfcne\u015f" e. Di \xe7anda kurd\xee de roj ronah\xee \xfb h\xeaviy\xea tems\xeel dike; nav\xean wek Roj\xeen j\xee ji heman kok\xea t\xea.','"Roj" hem "g\xfcn" hem "g\xfcne\u015f" anlam\u0131na gelir. K\xfcrt k\xfclt\xfcr\xfcnde \u0131\u015f\u0131k ve umutla ba\u011fda\u015ft\u0131r\u0131l\u0131r; Roj\xeen gibi isimler de ayn\u0131 k\xf6kten t\xfcretilir.')
B.UV=new A.aX('"Mal" t\xea wateya "ev / malbat". Di civaka kurd\xee de mal ne ten\xea avah\xee ye; malbat \xfb war\xea jiyan\xea ye. "Dibistan" j\xee t\xea wateya "okul".','"Mal" "ev / hane" demektir. K\xfcrt toplumunda yaln\u0131z bina de\u011fil, aile ve ya\u015fam alan\u0131n\u0131 da ifade eder. "Okul" kar\u015f\u0131l\u0131\u011f\u0131 "dibistan"d\u0131r.')
B.Vr=new A.aX('"Pirt\xfbk" t\xea wateya "kitap". Peyva "pirt\xfbkxane" j\xee "kitapxane/k\xfct\xfcphane" ye; xwendin \xfb zan\xeen bi pirt\xfbkan t\xea parastin.','"Pirt\xfbk" "kitap" demektir. "Pirt\xfbkxane" k\xfct\xfcphane anlam\u0131na gelir; okuma ve bilginin ta\u015f\u0131nd\u0131\u011f\u0131 temel nesnedir.')
B.Vf=new A.aX('Di d\xeemen\xea de "pirt\xfbk" t\xea n\xee\u015fandan \u2014 wateya w\xea "kitap" e. F\xearkirina peyvan bi d\xeemen\xea re h\xeasantir e ji bo destp\xeakeran.','G\xf6rsel "pirt\xfbk" kelimesini g\xf6sterir; do\u011fru T\xfcrk\xe7e kar\u015f\u0131l\u0131k "kitap"t\u0131r. G\xf6rselli kelime \xf6\u011frenimi ba\u015flang\u0131\xe7 seviyesinde peki\u015ftirir.')
B.VU=new A.aX('"Zan\xeen" t\xea wateya "bilmek / bilgi". Nav\xea sepan\xea ZanKurd j\xee ji "zan\xeen" t\xea \u2014 f\xearb\xfbna bi kurd\xee ye.','"Zan\xeen" "bilmek / bilgi" demektir. Uygulaman\u0131n ad\u0131 ZanKurd da ayn\u0131 k\xf6kten gelir: K\xfcrt\xe7e ile \xf6\u011frenmek.')
B.W4=new A.aX('"Hatin" t\xea wateya "gelmek". Ferman\xee "were!" j\xee ji heman kok\xea ye: "hatin" (gelmek) \xfb "were" (gel!).','"Hatin" "gelmek" demektir. Emir kipi "were!" (gel!) ayn\u0131 fiil ailesindendir.')
B.Vo=new A.aX('"\xc7iya" t\xea wateya "da\u011f". Di cografya \xfb stran\xean kurd\xee de \xe7iya gelek caran weh\u015fet, azad\xee \xfb war\xea gel\xea \xe7iyay\xee tems\xeel dike.','"\xc7iya" "da\u011f" demektir. K\xfcrt co\u011frafyas\u0131 ve t\xfcrk\xfclerinde da\u011f; yurt, \xf6zg\xfcrl\xfck ve da\u011f ya\u015fam\u0131n\u0131n simgesi olarak s\u0131k ge\xe7er.')
B.UX=new A.aX('"Dil" hem "kalp" hem j\xee "dil (ziman)" e. Di helbest \xfb stran\xean kurd\xee de dil c\xeeh\xea hest \xfb gotin\xea ye.','"Dil" hem "kalp" hem "dil (lisan)" anlam\u0131na gelebilir. \u015eiir ve t\xfcrk\xfclerde duygu ve s\xf6z\xfcn yuvas\u0131d\u0131r.')
B.UD=new A.aX('"Heval" t\xea wateya "arkada\u015f / yolda\u015f". Di civak\xea de hevalt\xee gir\xeadaneke xurt e; gelek caran "heval\xea dil" j\xee t\xea gotin.','"Heval" "arkada\u015f / yolda\u015f" demektir. Toplumsal ba\u011fda g\xfc\xe7l\xfc bir yer tutar; "g\xf6n\xfcl arkada\u015f\u0131" anlam\u0131nda da kullan\u0131l\u0131r.')
B.Uy=new A.aX('"Bajar" t\xea wateya "\u015fehir / kent". "Bajarok" j\xee t\xea wateya "kasaba". Bajar war\xea bazirgan\xee \xfb jiyana hevpar e.','"Bajar" "\u015fehir / kent" demektir. "Bajarok" ise kasaba anlam\u0131na gelir. Kent, ortak ya\u015fam ve ticaret alan\u0131d\u0131r.')
B.Ve=new A.aX('"Nan" t\xea wateya "ekmek". Di xwarina kurd\xee de nan bingeh e; "nan \xfb av" jiyan\xea tems\xeel dike.','"Nan" "ekmek" demektir. K\xfcrt mutfa\u011f\u0131nda temel besindir; "nan \xfb av" ya\u015fam\u0131n sade ifadesidir.')
B.UN=new A.aX('"R\xea" t\xea wateya "yol". Hem r\xeaya fiz\xeek\xee (\u015fose) hem j\xee r\xeaya jiyan\xea (r\xeaya rast) t\xea gotin.','"R\xea" "yol" demektir. Hem fiziksel yol hem mecaz anlamda hayat yolu ("do\u011fru yol") i\xe7in kullan\u0131l\u0131r.')
B.VM=new A.aX('Ji bo "te\u015fekk\xfcr" di Kurmanc\xee de "spas" t\xea gotin. "Spas dikim" t\xea wateya "te\u015fekk\xfcr ederim".','"Te\u015fekk\xfcr"\xfcn Kurmanc\xee kar\u015f\u0131l\u0131\u011f\u0131 "spas"t\u0131r. "Spas dikim" = te\u015fekk\xfcr ederim.')
B.Vi=new A.aX('"Spas" t\xea wateya "te\u015fekk\xfcr". Di dan\xfbstandina rojane de r\xeazgirtin\xea n\xee\u015fan dide.','"Spas" "te\u015fekk\xfcr" demektir. G\xfcnl\xfck ileti\u015fimde nezaket ve sayg\u0131 ifadesidir.')
B.UW=new A.aX('"Xwe\u015f" t\xea wateya "g\xfczel / iyi / ho\u015f". "Xwe\u015f be!" j\xee wek "afiyet olsun / iyi olsun" t\xea bikaran\xeen.','"Xwe\u015f" "g\xfczel / iyi / ho\u015f" demektir. "Xwe\u015f be!" afiyet olsun veya iyi olsun anlam\u0131nda kullan\u0131l\u0131r.')
B.UL=new A.aX('Di d\xeemen\xea de "xwe\u015f" t\xea n\xee\u015fandan \u2014 wateya w\xea "g\xfczel/iyi" ye. Ev peyv di hevok\xean rojane de pir t\xea bikaran\xeen.','G\xf6rsel "xwe\u015f" kelimesini g\xf6sterir; anlam\u0131 "g\xfczel/iyi"dir. G\xfcnl\xfck c\xfcmlelerde \xe7ok s\u0131k ge\xe7er.')
B.Vp=new A.aX('"Sar" t\xea wateya "so\u011fuk". Berevaj\xee w\xea "germ" e (s\u0131cak). Di heway\xea \xfb xwarin\xea de t\xea bikaran\xeen.','"Sar" "so\u011fuk" demektir. Kar\u015f\u0131t\u0131 "germ" (s\u0131cak)t\u0131r. Hem hava hem yemek i\xe7in kullan\u0131l\u0131r.')
B.Vz=new A.aX('Mezopotamya her\xeama di navbera D\xeecle \xfb Firat\xea de ye. J\xea re "war\xea du \xe7eman" j\xee t\xea gotin; yek ji kevintir\xeen navend\xean \u015faristaniy\xea ye.','Mezopotamya, Dicle ile F\u0131rat aras\u0131ndaki b\xf6lgedir. "\u0130ki nehir aras\u0131" olarak da an\u0131l\u0131r; en eski uygarl\u0131k merkezlerinden biridir.')
B.VW=new A.aX("Ciz\xeer (Cizre) navenda d\xeerok\xee ya M\xeergeha Botan\xea b\xfb. Li ser \xc7em\xea D\xeecle ye \xfb di \xe7and \xfb m\xeer\xeetiya kurd\xee de ciyek\xee sereke digire.","Cizre (Ciz\xeer), Botan M\xeerli\u011fi'nin tarih\xee merkezidir. Dicle k\u0131y\u0131s\u0131ndad\u0131r ve K\xfcrt beyli\u011fi ile k\xfclt\xfcr\xfcnde kilit bir yer tutar.")
B.UC=new A.aX("Komkujiya Heleb\xe7ey\xea di 16\xea Adara 1988an de p\xeak hat. Li ser gel\xea kurd \xear\xee\u015fa k\xeemyew\xee hat kirin; yek ji trajediy\xean her\xee mezin \xean sedsala 20an e.","Halep\xe7e katliam\u0131 16 Mart 1988'de ger\xe7ekle\u015fti. K\xfcrt halk\u0131na kar\u015f\u0131 kimyasal sald\u0131r\u0131 yap\u0131ld\u0131; 20. y\xfczy\u0131l\u0131n en b\xfcy\xfck trajedilerinden biridir.")
B.Uw=new A.aX("Peymana Lozan\xea (1923) s\xeenor\xean n\xfb y\xean Rojhilata Nav\xeen diyarkir. Cografya kurd\xee di nav \xe7ar dewletan de hat dabe\u015fkirin.","Lozan Antla\u015fmas\u0131 (1923) Ortado\u011fu'nun yeni s\u0131n\u0131rlar\u0131n\u0131 \xe7izdi. K\xfcrt co\u011frafyas\u0131 d\xf6rt devlet aras\u0131nda payla\u015ft\u0131r\u0131ld\u0131.")
B.Vv=new A.aX("Geliy\xea Munzur li D\xearsim\xea (Tunceli) ye \xfb wek parka netewey\xee t\xea parastin. \xc7em\xea Munzur \xfb xwezaya w\xea ji bo her\xeam\xea p\xeeroz t\xea d\xeetin.","Munzur vadisi Dersim (Tunceli)'dedir ve milli park stat\xfcs\xfcndedir. Munzur \xe7ay\u0131 ve do\u011fas\u0131 y\xf6re i\xe7in kutsald\u0131r.")
B.V9=new A.aX("\xc7iyay\xea Sipan (S\xfcphan) li bakur\xea Gola Wan\xea ye. Volkaneke vemir\xee ye \xfb yek ji bilindtir\xeen l\xfbtkey\xean her\xeam\xea ye.","S\xfcphan Da\u011f\u0131, Van G\xf6l\xfc'n\xfcn kuzeyindedir. S\xf6nm\xfc\u015f bir volkand\u0131r ve b\xf6lgenin en y\xfcksek doruklar\u0131ndan biridir.")
B.Vh=new A.aX('"Mem \xfb Z\xeen" berhema klas\xeek a Ehmed\xea Xan\xee ye (sedsala 17an). Ev destana ev\xeen\xea wek \u015eahnameya edebiyata kurd\xee t\xea d\xeetin.','"Mem \xfb Z\xeen", Ehmed\xea Xan\xee\'nin 17. y\xfczy\u0131ldaki klasik eseridir. Bu a\u015fk destan\u0131 K\xfcrt edebiyat\u0131n\u0131n ba\u015fyap\u0131t\u0131 kabul edilir.')
B.Vs=new A.aX('"\u015eal \xfb \u015fapik" cil \xfb berg\xean kevne\u015fop\xee y\xean m\xearan e: \u015fal (\u015falwar/par\xe7e) \xfb \u015fapik (kiras). Di govend \xfb \u015fahiyan de j\xee t\xea li xwe kirin.','"\u015eal \xfb \u015fapik" geleneksel erkek giyim tak\u0131m\u0131d\u0131r: \u015fal (\u015falvar/ku\u015fam) ve \u015fapik (g\xf6mlek). Govend ve t\xf6renlerde de giyilir.')
B.awe=new A.bt(B.axC,[B.Va,B.V2,B.UR,B.Vk,B.UY,B.VC,B.VE,B.W_,B.Ur,B.VV,B.UH,B.VO,B.UG,B.UP,B.VK,B.UU,B.Ut,B.VX,B.VL,B.V4,B.Vg,B.VN,B.Vx,B.UF,B.VP,B.V_,B.UO,B.Vc,B.VZ,B.W3,B.W1,B.VD,B.Vw,B.Us,B.V3,B.Uu,B.V7,B.UM,B.UK,B.VH,B.V8,B.UT,B.VI,B.Vd,B.Vn,B.VQ,B.VJ,B.Vj,B.UJ,B.Uz,B.UA,B.V5,B.UE,B.Vq,B.VT,B.US,B.Vy,B.VR,B.W2,B.UI,B.VY,B.V6,B.W0,B.V0,B.VF,B.VB,B.UB,B.VS,B.Uv,B.VG,B.UZ,B.V1,B.Vl,B.VA,B.Vb,B.Vu,B.Vt,B.UQ,B.Vm,B.Ux,B.UV,B.Vr,B.Vf,B.VU,B.W4,B.Vo,B.UX,B.UD,B.Uy,B.Ve,B.UN,B.VM,B.Vi,B.UW,B.UL,B.Vp,B.Vz,B.VW,B.UC,B.Uw,B.Vv,B.V9,B.Vh,B.Vs],A.aM("bt<q,aX>"))
B.axM={"iso_8859-1:1987":0,"iso-ir-100":1,"iso_8859-1":2,"iso-8859-1":3,latin1:4,l1:5,ibm819:6,cp819:7,csisolatin1:8,"iso-ir-6":9,"ansi_x3.4-1968":10,"ansi_x3.4-1986":11,"iso_646.irv:1991":12,"iso646-us":13,"us-ascii":14,us:15,ibm367:16,cp367:17,csascii:18,ascii:19,csutf8:20,"utf-8":21}
